{
  "aprop-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|grep_search",
        "hooks": [
          { "type": "command", "command": "bash scripts/ai/hooks/guard.sh", "timeout": 30 }
        ]
      }
    ]
  },
  "aprop-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "bash scripts/ai/hooks/after-edit.sh", "timeout": 60 }
        ]
      }
    ]
  },
  "aprop-analyze": {
    "Stop": [
      { "type": "command", "command": "bash scripts/ai/hooks/on-stop.sh", "timeout": 180 }
    ]
  }
}
