{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash scripts/ai/hooks/guard.sh",
        "matcher": "git|rm |\\.env|\\.pem|\\.key|id_rsa",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash scripts/ai/hooks/after-edit.sh",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "bash scripts/ai/hooks/on-stop.sh",
        "timeout": 180,
        "loop_limit": 2
      }
    ]
  }
}
